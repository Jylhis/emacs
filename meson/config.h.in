#mesondefine HAVE_PATHS_H
#mesondefine HAVE_TERMIOS_H
#mesondefine HAVE_TERMIO_H
#mesondefine HAVE_SGTTY_H
#mesondefine HAVE_GRP_H

/* Linux xattr-based ACL detection (m4/acl.m4).  */
#mesondefine HAVE_LINUX_XATTR_H
#mesondefine HAVE_LISTXATTR
#mesondefine USE_ACL

/* File notification (configure.ac:619-3712).  Backend is selected
   at configure time: inotify (Linux), kqueue (macOS/BSD), or
   gfile (GLib fallback).  */
#mesondefine USE_FILE_NOTIFY
#mesondefine HAVE_INOTIFY
#mesondefine HAVE_KQUEUE
#mesondefine HAVE_GFILENOTIFY

/* HAVE_MODULES is gated above on the configure-time --with-modules
   option + dlopen availability.  */
#mesondefine MODULES_SUFFIX
/* MODULES_SECONDARY_SUFFIX: on Darwin this is ".so" (so .so modules
   work alongside .dylib).  On other systems it is undefined -- NOT
   empty, because lread.c:1264 treats any non-NULL value as a real
   suffix to test.  */
#mesondefine MODULES_SECONDARY_SUFFIX

/* Portable dumper -- mandatory for the meson build per the migration
   plan (configure.ac:437, --with-pdumper=yes default).  */
#define HAVE_PDUMPER 1
#define DUMPING_PDUMPER 1

/* Native-comp .eln file suffix (configure.ac:1755).  */
#define NATIVE_ELISP_SUFFIX ".eln"

/* Modern Xlib opaqueness probes (configure.ac AC_CHECK_FUNCS
   block).  Set conditionally in meson.build when GTK3/X11 is
   found.  */
#mesondefine HAVE_XRMSETDATABASE
#mesondefine HAVE_XKB
#mesondefine HAVE_XRENDER
#mesondefine HAVE_XCOMPOSITE
