/* OS family defines (configure.ac:6187-6196).  */
#mesondefine DARWIN_OS
#mesondefine GNU_LINUX
#mesondefine USG

/* PTY support (configure.ac:5808-6023).  */
#mesondefine HAVE_PTYS
