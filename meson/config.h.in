/* Declaration probes (HAVE_DECL_* style, for gnulib headers).  */
#mesondefine HAVE_DECL_STRMODE
#mesondefine HAVE_COPY_FILE_RANGE
#mesondefine HAVE_MEMRCHR

/* Declarations for functions gnulib provides when the system lacks them.  */
#ifndef HAVE_COPY_FILE_RANGE
# include <unistd.h>
extern ssize_t copy_file_range (int __infd, off_t *__pinoff,
                                int __outfd, off_t *__poutoff,
                                size_t __length, unsigned int __flags);
#endif

/* glibc *_unlocked stdio variants used by lib/unlocked-io.h.  */
#mesondefine HAVE_DECL_CLEARERR_UNLOCKED
#mesondefine HAVE_DECL_FEOF_UNLOCKED
#mesondefine HAVE_DECL_FERROR_UNLOCKED
#mesondefine HAVE_DECL_FFLUSH_UNLOCKED
#mesondefine HAVE_DECL_FGETS_UNLOCKED
#mesondefine HAVE_DECL_FILENO_UNLOCKED
#mesondefine HAVE_DECL_FPUTC_UNLOCKED
#mesondefine HAVE_DECL_FPUTS_UNLOCKED
#mesondefine HAVE_DECL_FREAD_UNLOCKED
#mesondefine HAVE_DECL_FWRITE_UNLOCKED
#mesondefine HAVE_DECL_GETC_UNLOCKED
#mesondefine HAVE_DECL_GETCHAR_UNLOCKED
#mesondefine HAVE_DECL_PUTC_UNLOCKED
#mesondefine HAVE_DECL_PUTCHAR_UNLOCKED

/* gnulib getopt: prefix all getopt symbols to avoid clashes with the
   system <getopt.h> (m4/getopt.m4:370, configure.ac via gl_GETOPT).
   Must appear before any header that might pull in <getopt.h>.  */
#define __GETOPT_PREFIX rpl_

/* Text domain for gnulib message translation (m4/gettext_h.m4:17).
   Emacs does not translate gnulib messages, but the macro must be
   defined so getopt.c's dgettext() calls compile.  */
#ifndef GNULIB_TEXT_DOMAIN
# define GNULIB_TEXT_DOMAIN "gnulib"
#endif

/* Tell gnulib ieee754.h to use the portable (non-glibc) code path
   (lib/ieee754.in.h:20).  Without this, it includes <features.h>
   and <bits/endian.h> which only exist on glibc.  */
#define _GL_GNULIB_HEADER 1

/* Pull in the gnulib-common preprocessor block extracted from
   m4/gnulib-common.m4 by meson/extract_ah_verbatim.py.  This provides
   _GL_ATTRIBUTE_*, _Noreturn, _GL_GNUC_PREREQ, and friends used by
   lib/attribute.h and other gnulib headers.  */
#include "gnulib-common.h"

/* gnulib's fcntl.in.h is processed into lib/fcntl.h by autotools and
   guarantees O_BINARY / O_SEARCH / O_EXEC exist.  Phase 2 of the
   Meson migration will process the same .in.h.  Until then, define
   them to 0 on systems that don't provide them (Linux, macOS).  */
#include <fcntl.h>
#ifndef O_BINARY
# define O_BINARY 0
#endif
#ifndef O_TEXT
# define O_TEXT 0
#endif
#ifndef O_SEARCH
# define O_SEARCH O_RDONLY
#endif
#ifndef O_EXEC
# define O_EXEC O_RDONLY
#endif

/* gnulib expects <stddef.h> types (ptrdiff_t, size_t) to be available
   transitively via config.h.  */
#include <stddef.h>

/* On macOS, environ is not declared in any header but is available
   via crt_externs.h or as a plain extern.  Several src/ files
   (callproc.c, emacs.c) reference it directly.  */
#ifdef DARWIN_OS
# include <crt_externs.h>
# define environ (*_NSGetEnviron())
#endif

/* AH_BOTTOM equivalent: the autotools build appends conf_post.h to
   the bottom of config.h.  conf_post.h provides ATTRIBUTE_*,
   UNINIT, and various platform tweaks used throughout Emacs.  */
#include <conf_post.h>

/* glibc 2.34+ realloc(p, 0) frees p and returns NULL, which
   src/alloc.c xrealloc() misinterprets as memory exhaustion
   (lib/realloc.c:42 + m4/realloc.m4 logic).  Only the Emacs core
   needs the legacy "always non-null" behavior; lib-src tools and
   gnulib internals rely on the modern semantics.  EMACS_CORE is
   set on src/ compile lines to opt in.  */
#ifdef EMACS_CORE
extern void *rpl_realloc (void *, size_t);
# define realloc rpl_realloc
#endif

/* Phase-2 stopgap: gnulib's time_rz module provides timezone_t in
   the substituted <time.h>.  Until lib/time.in.h substitution
   lands, declare an opaque type so timefns.c et al compile.  Since
   this is a typedef and Emacs only handles timezone_t through the
   tzalloc/tzfree gnulib API, the implementation is opaque enough
   that a forward declaration suffices for compilation.  */
typedef struct tm_zone *timezone_t;

/* Phase-2 stopgap for SIG2STR_MAX from gnulib lib/signal.in.h.  */
#ifndef SIG2STR_MAX
# define SIG2STR_MAX (5 + 1 + 10 + 1 + 2)
#endif

/* O_IGNORE_CTTY is a GNU/Hurd extension; no-op on other systems
   (configure.ac, term.c:2513).  */
#ifndef O_IGNORE_CTTY
# define O_IGNORE_CTTY 0
#endif

/* Phase-2 stopgap for getrandom / GRND_* flags.  macOS
   <sys/random.h> provides getentropy but not getrandom or the GRND_*
   constants.  gnulib's sys_random.in.h normally wraps these, but
   until sys_random.in.h substitution lands we define the shims here.
   The actual getrandom implementation is in lib/getrandom.c (added
   to libgnu_sources).  Values match the Linux definitions.  */
#include <sys/random.h>
#ifndef GRND_NONBLOCK
# define GRND_NONBLOCK 1
#endif
#ifndef GRND_RANDOM
# define GRND_RANDOM 2
#endif
#ifndef HAVE_GETRANDOM
# include <stddef.h>
# include <unistd.h>
extern ssize_t getrandom (void *__buffer, size_t __length,
                           unsigned int __flags);
#endif

/* Phase-2 stopgap for pipe2.  macOS does not provide pipe2;
   gnulib's unistd.in.h normally declares it, but until that
   substitution lands we declare it here.  The implementation
   is in lib/pipe2.c (conditionally added to libgnu_sources).  */
#ifndef HAVE_PIPE2
extern int pipe2 (int fd[2], int flags);
#endif

/* Phase-2 stopgap for sigdescr_np.  macOS does not provide
   sigdescr_np; gnulib's string.in.h declares it when
   GNULIB_SIGDESCR_NP is set.  Belt-and-suspenders declaration
   here ensures all compilation units see the prototype.  The
   implementation is in lib/sigdescr_np.c.  */
#ifndef HAVE_SIGDESCR_NP
extern const char *sigdescr_np (int sig);
#endif

/* Stat-type test macros that gnulib's <sys/stat.h> substitute would
   otherwise define to 0.  Phase-2 stopgap until lib/sys_stat.in.h is
   substituted.  */
#include <sys/stat.h>
#ifndef S_TYPEISTMO
# define S_TYPEISTMO(p) 0
#endif
#ifndef S_ISCTG
# define S_ISCTG(m) 0
#endif
#ifndef S_ISDOOR
# define S_ISDOOR(m) 0
#endif
#ifndef S_ISMPB
# define S_ISMPB(m) 0
#endif
#ifndef S_ISMPC
# define S_ISMPC(m) 0
#endif
#ifndef S_ISMPX
# define S_ISMPX(m) 0
#endif
#ifndef S_ISNWK
# define S_ISNWK(m) 0
#endif
#ifndef S_ISPORT
# define S_ISPORT(m) 0
#endif
#ifndef S_ISWHT
# define S_ISWHT(m) 0
#endif

#endif /* EMACS_CONFIG_H */
