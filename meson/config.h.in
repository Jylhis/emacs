#mesondefine PTY_NAME_SPRINTF
#mesondefine PTY_TTY_NAME_SPRINTF

/* TAB3 on Darwin is OXTABS (configure.ac:6074).  */
#mesondefine TAB3

/* From lib/dirent.in.h (phase-2 stopgap: full dirent.h substitution
   pending).  */
#define _GL_DT_NOTDIR 0x100

/* AC_CHECK_FUNCS_ONCE block (configure.ac).  */
#mesondefine HAVE_CFMAKERAW
